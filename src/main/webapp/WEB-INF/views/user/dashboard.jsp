<%@ include file="../common/header.jsp" %><section class="section-head"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>Good to see you, ${sessionScope.user.name}.</h1></div><a class="button" href="${pageContext.request.contextPath}/auction/create">Create auction</a></section><section class="stats"><div><small>My auctions</small><strong>${myAuctions.size()}</strong></div><div><small>My bids</small><strong>${myBids.size()}</strong></div><div><small>Live opportunities</small><strong>${active.size()}</strong></div></section><section><div class="section-head"><h2>Live auctions</h2><a href="${pageContext.request.contextPath}/auctions">View all</a></div><div class="cards"><c:forEach items="${active}" var="a"><article class="auction-card compact"><h3>${a.title}</h3><span class="badge ${a.status}">${a.status}</span><p>₹${a.currentHighestBid}</p><a href="${pageContext.request.contextPath}/auction?id=${a.id}">Open auction →</a></article></c:forEach></div></section><%@ include file="../common/footer.jsp" %>
