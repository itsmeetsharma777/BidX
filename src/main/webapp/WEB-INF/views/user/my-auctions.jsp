<%@ include file="../common/header.jsp" %><section class="section-head"><div><p class="eyebrow">AUCTION CREATOR</p><h1>My auctions</h1></div><a class="button" href="${pageContext.request.contextPath}/auction/create">Create auction</a></section><table><thead><tr><th>Item</th><th>Current bid</th><th>Status</th><th>Ends</th></tr></thead><tbody><c:forEach items="${auctions}" var="a"><tr><td><a href="${pageContext.request.contextPath}/auction?id=${a.id}">${a.title}</a></td><td>Rs. ${a.currentHighestBidFormatted}</td><td><span class="badge ${a.status}">${a.status}</span></td><td>${a.endAt}</td></tr></c:forEach></tbody></table><c:if test="${empty auctions}"><div class="empty"><h3>You have not created any auctions.</h3><a class="button" href="${pageContext.request.contextPath}/auction/create">Create your first auction</a></div></c:if><%@ include file="../common/footer.jsp" %>
