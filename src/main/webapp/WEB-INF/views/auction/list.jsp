<%@ include file="../common/header.jsp" %><c:if test="${home}"><section class="hero"><div><p class="eyebrow">SIMPLE ONLINE AUCTIONS</p><h1>Bid smart. Win more.</h1><p>Create an auction or join one as a member. Every bid and final price is clearly recorded.</p><a class="button" href="#market">Browse auctions</a></div><div class="hero-card"><span>BIDX</span><strong>Create. Bid.<br>Win.</strong><small>Simple, secure and local.</small></div></section></c:if><section id="market" class="section-head"><div><p class="eyebrow">AUCTIONS</p><h2>${home ? 'Open auctions' : 'Browse auctions'}</h2></div><form class="filters"><input name="q" value="${param.q}" placeholder="Search auctions"><select name="category"><option value="">All categories</option><option>Electronics</option><option>Books</option><option>Collectibles</option><option>Fashion</option><option>Home &amp; Living</option></select><select name="status"><option value="">Any status</option><option value="ACTIVE">Live</option><option value="ENDING_SOON">Ending soon</option><option value="UPCOMING">Upcoming</option></select><button class="button small">Search</button></form></section><section class="cards"><c:forEach items="${auctions}" var="a"><article class="auction-card"><div class="product-art">Item</div><div class="card-body"><span class="badge ${a.status}">${a.status}</span><p class="muted">${a.category}</p><h3>${a.title}</h3><div class="price"><small>Current bid</small><strong>Rs. ${a.currentHighestBid}</strong></div><p class="muted">Ends ${a.endAt}</p><a class="button outline" href="${pageContext.request.contextPath}/auction?id=${a.id}">View auction</a></div></article></c:forEach></section><c:if test="${empty auctions}"><div class="empty"><h3>No auctions yet.</h3><p>When an Auction Creator adds an item, it will appear here.</p></div></c:if><%@ include file="../common/footer.jsp" %>
