<%@ include file="../common/header.jsp" %><section class="detail"><div class="detail-art">Item</div><div><span class="badge ${auction.status}">${auction.status}</span><p class="eyebrow">${auction.category} · ${auction.condition}</p><h1>${auction.title}</h1><p>${auction.description}</p><div class="metrics"><div><small>Current highest bid</small><strong>Rs. ${auction.currentHighestBidFormatted}</strong></div><div><small>Minimum next bid</small><strong>Rs. ${minimum}</strong></div><div><small>Ends</small><strong>${auction.endAt}</strong></div></div><c:if test="${not empty winnerName}"><section class="winner-panel"><p class="eyebrow">AUCTION RESULT</p><h2>Winner: ${winnerName}</h2><p>Winning bid: <strong>Rs. ${auction.currentHighestBidFormatted}</strong></p></section></c:if><c:if test="${auction.status.toString() == 'CLOSED'}"><section class="winner-panel"><p class="eyebrow">AUCTION CLOSED</p><h2>No bids were placed.</h2></section></c:if><c:if test="${not empty sessionScope.user && (auction.status == 'ACTIVE' || auction.status == 'ENDING_SOON')}"><form class="bid-form panel" action="${pageContext.request.contextPath}/bid" method="post"><input type="hidden" name="auctionId" value="${auction.id}"><label>Your bid (minimum Rs. ${minimum})<input name="amount" type="number" min="${minimum}" step="1" required></label><button class="button">Place bid</button></form></c:if><c:if test="${empty sessionScope.user}"><p><a href="${pageContext.request.contextPath}/login">Sign in</a> to place a bid.</p></c:if></div></section><section class="history"><div class="section-head"><h2>Bid history</h2><span>${bids.size()} bids</span></div><table><thead><tr><th>Bidder</th><th>Amount</th><th>Time</th></tr></thead><tbody><c:forEach items="${bids}" var="b"><tr><td>${bidderNames[b.bidderId]}</td><td>Rs. ${b.amountFormatted}</td><td>${b.createdAt}</td></tr></c:forEach></tbody></table><c:if test="${empty bids}"><div class="empty">No bids yet. Be the first to bid.</div></c:if></section><%@ include file="../common/footer.jsp" %>
