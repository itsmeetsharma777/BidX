<%@ include file="../common/header.jsp" %><section class="form-page"><div><p class="eyebrow">SELL ON BIDX</p><h1>Create an auction</h1><p>Clear details create confident bidders.</p></div><form class="panel grid-form" method="post"><label>Title<input name="title" required></label><label>Category<select name="category"><option>Electronics</option><option>Books</option><option>Collectibles</option><option>Fashion</option><option>Home &amp; Living</option><option>Other</option></select></label><label>Description<textarea name="description" required></textarea></label><label>Condition<select name="condition"><option>New</option><option>Like New</option><option>Good</option><option>Fair</option></select></label><label>Starting price<input name="startingPrice" type="number" min="0" step="0.01" required></label><label>Minimum increment<input name="increment" type="number" min="1" step="0.01" required></label><label>Starts<input name="startAt" type="datetime-local" required></label><label>Ends<input name="endAt" type="datetime-local" required></label><label>Notes (optional)<textarea name="notes"></textarea></label><button class="button">Publish auction</button></form></section><%@ include file="../common/footer.jsp" %>
